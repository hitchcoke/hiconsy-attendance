{
  "name": "hiconsy-attendance",
  "productName": "Hiconsy Attendance",
  "version": "1.0.0",
  "description": "팀의 하루를 연결하는 근태관리 데스크톱 앱",
  "author": "Hiconsy assignment",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=10.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vue-tsc --noEmit -p tsconfig.ui.json && vite build",
    "build": "npm run build:server && npm run build:ui",
    "server": "node dist/server/main.js",
    "server:demo": "node --env-file=.env.demo dist/server/main.js",
    "db:init": "npm run build:server && node dist/server/cli.js init",
    "demo:reset": "npm run build:server && node --env-file=.env.demo dist/server/cli.js reset",
    "test": "npm run build:server && node --test --test-concurrency=1 dist/server/tests/*.test.js",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "postinstall": "node node_modules/electron/install.js",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"electron/*.cjs\" \"scripts/*.mjs\" \"*.{json,mts,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"electron/*.cjs\" \"scripts/*.mjs\" \"*.{json,mts,cjs}\"",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "better-sqlite3": "12.11.1",
    "electron": "45.2.1",
    "element-plus": "^2.11.0",
    "pinia": "^3.0.0",
    "playwright": "^1.56.0",
    "prettier": "3.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.1.0",
    "typeorm": "0.3.28",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vue": "3.5.44",
    "vue-router": "^4.6.0",
    "vue-tsc": "^3.1.0"
  }
}
